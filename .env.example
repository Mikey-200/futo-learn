# FUTO Learn — Environment Variables
# Copy this file to .env and fill in your own API keys.
# NEVER commit .env — it contains private keys.

# Groq API key (lesson generation + quiz generation)
# Get yours free at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Google Gemini API key (scanned PDF OCR only)
# Get yours free at: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here
